# --- Нашият модел (OpenAI-съвместим endpoint: vLLM, LM Studio, OpenRouter, собствен gateway...) ---
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=change-me
LLM_MODEL=your-model-name
LLM_TEMPERATURE=0.2
# true = агентът получава и скрийншоти (модел с vision); false = само текст
LLM_VISION=true
# По желание: reasoning_effort за reasoning модели (low|medium|high)
LLM_REASONING_EFFORT=
# Модел за класификация на отговорите (по подразбиране = LLM_MODEL)
CLASSIFIER_MODEL=

# --- Браузърът на OpenWork ---
# Празно = автоматично от ~/Library/Application Support/com.differentai.openwork/DevToolsActivePort
OPENWORK_CDP_URL=
# Ако във вградения браузър има няколко таба: част от URL-а на таба, който агентът да ползва
OPENWORK_TAB_MATCH=facebook.com

# --- Агентът ---
# Стъпки на един рунд; ако не стигнат, програмата пуска агента да продължи (до AGENT_MAX_ROUNDS рунда)
AGENT_MAX_STEPS=250
AGENT_TIMEOUT=21600
AGENT_MAX_ROUNDS=30
# Максимално време за една стъпка (клетка) на агента, секунди; извличането на една локация отнема минути
AGENT_CELL_TIMEOUT=4000

# --- Щадящ режим за акаунта ---
# Пауза между зарежданията на страници (случайна в този интервал, секунди)
PACE_MIN_SECONDS=4
PACE_MAX_SECONDS=10
# Максимум заредени страници на ден; после спира и продължава с --resume на следващия ден
DAILY_PAGE_CAP=5000
# Най-много време за една локация (всички ревюта + второ минаване), секунди
LOCATION_MAX_SECONDS=3600

# Допълнителна заявка "съдия" след всеки run на browser-use (струва токени)
AGENT_JUDGE=false

# browser-use телеметрия: изключена
ANONYMIZED_TELEMETRY=false
BROWSER_USE_NO_UPDATE_CHECK=1
